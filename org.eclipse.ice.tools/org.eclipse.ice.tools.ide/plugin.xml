<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
	<extension-point id="org.eclipse.ice.tools.ide.code" name="Scientific Code" schema="schema/iceDevCode.exsd"/>
	
	
   <!--extension
         id="org.eclipse.ice.tools.ide.menu"
         name="Developer"
         point="org.eclipse.ui.menus">
      <menuContribution
            allPopups="false"
            class="org.eclipse.ice.tools.ide.menu.ICEExtensionContributionFactory"
            locationURI="menu:org.eclipse.ui.main.menu">
      </menuContribution>
   </extension-->
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            allPopups="false"
            locationURI="menu:org.eclipse.ui.main.menu?after=project">
         <menu
               id="org.eclipse.ice.tools.ide.menu"
               label="ICE">
	         <menu
                id="org.eclipse.ice.tools.ide.menu.ice"
                label="ICE">
             <command
                   commandId="org.eclipse.ice.tools.ide.command.cloneAndFix"
                   label="Clone"
                   style="push">
                <parameter
                      name="repoURLID"
                      value="https://gitlab.eclipse.org/eclipse/ice/ice">
                </parameter>
                <parameter
                      name="branchID"
                      value="next">
                </parameter>
             </command>
             <command
                   commandId="org.eclipse.ice.tools.ide.command.build"
                   label="Build"
                   style="push">
             </command>
             <command
                   commandId="org.eclipse.ice.tools.ide.command.launch"
                   label="Launch New Instance"
                   style="push">
             </command>
             <command
                   commandId="org.eclipse.ice.tools.ide.command.importLocalRepo"
                   label="Import Local Repository"
                   style="push">
             </command>
	            <menu
                   id="org.eclipse.ice.tools.ide.menu.ice.tests"
                   label="ICE Tests">
                <command
                      commandId="org.eclipse.ice.tools.ide.command.clone"
                      label="Clone ICETests to user.home"
                      style="push">
                   <parameter
                         name="repoURLID"
                         value="https://github.com/jayjaybillings/ICETests">
                   </parameter>
                   <parameter
                         name="branchID"
                         value="master">
                   </parameter>
                   <parameter
                         name="cloneDirectoryID"
                         value="@user.home">
                   </parameter>
                </command>
	            </menu>
	         </menu>
          <menu
                id="org.eclipse.ice.tools.ide.menu.framework"
                label="Framework">
	         <menu
                id="org.eclipse.ice.tools.ide.menu.framework.eavp"
                label="EAVP">
             <command
                   commandId="org.eclipse.ice.tools.ide.command.cloneAndFix"
                   label="Clone"
                   style="push">
                <parameter
                      name="repoURLID"
                      value="https://github.com/eclipse/eavp">
                </parameter>
                <parameter
                      name="branchID"
                      value="next">
                </parameter>
             </command>
	         </menu>
          </menu>
          <menu
                id="org.eclipse.ice.tools.ide.menu.nuclear"
                label="Nuclear">
          </menu>
          <menu
                id="org.eclipse.ice.tools.ide.menu.molecularDynamics"
                label="Molecular Dynamics">
          </menu>
          <menu
                id="org.eclipse.ice.tools.ide.menu.physics"
                label="Physics">
          </menu>
          <menu
                id="org.eclipse.ice.tools.ide.menu.densityFunctionalTheory"
                label="Density Functional Theory">
          </menu>
         </menu>
      </menuContribution>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
      <command
            id="org.eclipse.ice.tools.ide.command.clone"
            name="Clone">
         <commandParameter
               id="repoURLID"
               name="repoURL"
               optional="true">
         </commandParameter>
         <commandParameter
               id="branchID"
               name="branch"
               optional="true">
         </commandParameter>
         <commandParameter
               id="cloneDirectoryID"
               name="cloneDirectory"
               optional="true">
         </commandParameter>
      </command>
      <command
            id="org.eclipse.ice.tools.ide.command.cloneAndFix"
            name="CloneAndFix">
         <commandParameter
               id="repoURLID"
               name="repoURL"
               optional="true">
         </commandParameter>
         <commandParameter
               id="branchID"
               name="branch"
               optional="true">
         </commandParameter>
         <commandParameter
               id="cloneDirectoryID"
               name="cloneDirectory"
               optional="true">
         </commandParameter>
      </command>
      <command
            id="org.eclipse.ice.tools.ide.command.build"
            name="Build">
      </command>
      <command
            id="org.eclipse.ice.tools.ide.command.launch"
            name="Launch">
      </command>
      <command
            id="org.eclipse.ice.tools.ide.command.importLocalRepo"
            name="Import Local">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="org.eclipse.ice.tools.ide.actions.GitCloneHandler"
            commandId="org.eclipse.ice.tools.ide.command.clone">
      </handler>
      <handler
            class="org.eclipse.ice.tools.ide.actions.BuildICEHandler"
            commandId="org.eclipse.ice.tools.ide.command.build">
      </handler>
      <handler
            class="org.eclipse.ice.tools.ide.actions.LaunchNewICEHandler"
            commandId="org.eclipse.ice.tools.ide.command.launch">
      </handler>
      <handler
            class="org.eclipse.ice.tools.ide.actions.ImportLocalICEHandler"
            commandId="org.eclipse.ice.tools.ide.command.importLocalRepo">
      </handler>
      <handler
            class="org.eclipse.ice.tools.ide.actions.FixMavenLifecycleCloneHandler"
            commandId="org.eclipse.ice.tools.ide.command.cloneAndFix">
      </handler>
   </extension>
   
</plugin>
